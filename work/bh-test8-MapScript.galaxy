include "TriggerLibs/NativeLib"

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
}

//--------------------------------------------------------------------------------------------------
// Global Variables
//--------------------------------------------------------------------------------------------------
int gv_killCount;

void InitGlobals () {
}

//--------------------------------------------------------------------------------------------------
// Trigger Variables
//--------------------------------------------------------------------------------------------------
trigger gt_MeleeInitialization;
trigger gt_UntitledTrigger002;
trigger gt_UntitledTrigger003;
trigger gt_UntitledTrigger004;

//--------------------------------------------------------------------------------------------------
// Trigger: Melee Initialization
//--------------------------------------------------------------------------------------------------
bool gt_MeleeInitialization_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    MeleeInitResources();
    MeleeInitUnits();
    MeleeInitAI();
    MeleeInitOptions();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MeleeInitialization_Init () {
    gt_MeleeInitialization = TriggerCreate("gt_MeleeInitialization_Func");
    TriggerAddEventMapInit(gt_MeleeInitialization);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Untitled Trigger 002
//--------------------------------------------------------------------------------------------------
bool gt_UntitledTrigger002_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/62B531FB"));
    libNtve_gf_UnitCreateFacingPoint(1, "Marine", 0, 1, Point(64.0, 64.0), Point(64.0, 64.0));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UntitledTrigger002_Init () {
    gt_UntitledTrigger002 = TriggerCreate("gt_UntitledTrigger002_Func");
    TriggerAddEventMapInit(gt_UntitledTrigger002);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Untitled Trigger 003
//--------------------------------------------------------------------------------------------------
bool gt_UntitledTrigger003_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/143E6AEB"));
    libNtve_gf_UnitCreateFacingPoint(1, "Zergling", 0, 2, Point(64.0, 64.0), Point(64.0, 64.0));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UntitledTrigger003_Init () {
    gt_UntitledTrigger003 = TriggerCreate("gt_UntitledTrigger003_Func");
    TriggerAddEventTimePeriodic(gt_UntitledTrigger003, 5.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Untitled Trigger 004
//--------------------------------------------------------------------------------------------------
bool gt_UntitledTrigger004_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/ADFBAA21"));
    gv_killCount += 1;
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UntitledTrigger004_Init () {
    gt_UntitledTrigger004 = TriggerCreate("gt_UntitledTrigger004_Func");
    TriggerAddEventUnitDied(gt_UntitledTrigger004, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_MeleeInitialization_Init();
    gt_UntitledTrigger002_Init();
    gt_UntitledTrigger003_Init();
    gt_UntitledTrigger004_Init();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    InitLibs();
    InitGlobals();
    InitTriggers();
}
