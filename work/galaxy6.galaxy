    libNtve_gf_UnitCreateFacingPoint(1, "Marauder", 0, 1, Point(64.0, 64.0), Point(64.0, 64.0));
    DialogSetVisible(gv_buffDialog, PlayerGroupAll(), false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Buff2_Init () {
    gt_Buff2 = TriggerCreate("gt_Buff2_Func");
    TriggerAddEventDialogControl(gt_Buff2, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

