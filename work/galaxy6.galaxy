    TriggerAddEventDialogControl(gt_Buff3, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_UntitledTrigger002_Init();
    gt_UntitledTrigger003_Init();
    gt_UntitledTrigger004_Init();
    gt_BuffChoice_Init();
    gt_Buff1_Init();
    gt_Buff2_Init();
    gt_Buff3_Init();
}

