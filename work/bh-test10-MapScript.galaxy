//==================================================================================================
// 
// Generated Map Script
// 
// Name:   Just Another StarCraft II Map
// 
//==================================================================================================
include "TriggerLibs/NativeLib"

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
}

//--------------------------------------------------------------------------------------------------
// Global Variables
//--------------------------------------------------------------------------------------------------
int gv_killCount;
int gv_buffBtn3;
int gv_buffBtn2;
int gv_buffBtn1;
int gv_buffDialog;

void InitGlobals () {
    gv_buffBtn3 = c_invalidDialogControlId;
    gv_buffBtn2 = c_invalidDialogControlId;
    gv_buffBtn1 = c_invalidDialogControlId;
    gv_buffDialog = c_invalidDialogId;
}

//--------------------------------------------------------------------------------------------------
// Trigger Variables
//--------------------------------------------------------------------------------------------------
trigger gt_MeleeInitialization;
trigger gt_UntitledTrigger002;
trigger gt_UntitledTrigger003;
trigger gt_UntitledTrigger004;
trigger gt_BuffChoice;

//--------------------------------------------------------------------------------------------------
// Trigger: Melee Initialization
//--------------------------------------------------------------------------------------------------
bool gt_MeleeInitialization_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    MeleeInitResources();
    MeleeInitUnits();
    MeleeInitAI();
    MeleeInitOptions();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MeleeInitialization_Init () {
    gt_MeleeInitialization = TriggerCreate("gt_MeleeInitialization_Func");
    TriggerAddEventMapInit(gt_MeleeInitialization);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Untitled Trigger 002
//--------------------------------------------------------------------------------------------------
bool gt_UntitledTrigger002_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/62B531FB"));
    libNtve_gf_UnitCreateFacingPoint(1, "Marine", 0, 1, Point(64.0, 64.0), Point(64.0, 64.0));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UntitledTrigger002_Init () {
    gt_UntitledTrigger002 = TriggerCreate("gt_UntitledTrigger002_Func");
    TriggerAddEventMapInit(gt_UntitledTrigger002);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Untitled Trigger 003
//--------------------------------------------------------------------------------------------------
bool gt_UntitledTrigger003_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/143E6AEB"));
    libNtve_gf_UnitCreateFacingPoint(1, "Zergling", 0, 2, Point(RandomFixed(16.0, 112.0), RandomFixed(16.0, 112.0)), Point(64.0, 64.0));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UntitledTrigger003_Init () {
    gt_UntitledTrigger003 = TriggerCreate("gt_UntitledTrigger003_Func");
    TriggerAddEventTimePeriodic(gt_UntitledTrigger003, 5.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Untitled Trigger 004
//--------------------------------------------------------------------------------------------------
bool gt_UntitledTrigger004_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, IntToText(gv_killCount));
    gv_killCount += 1;
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UntitledTrigger004_Init () {
    gt_UntitledTrigger004 = TriggerCreate("gt_UntitledTrigger004_Func");
    TriggerAddEventUnitDied(gt_UntitledTrigger004, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: BuffChoice
//--------------------------------------------------------------------------------------------------
bool gt_BuffChoice_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    DialogCreate(500, 400, c_anchorCenter, 0, 0, true);
    libNtve_gf_CreateDialogItemButton(DialogLastCreated(), 200, 50, c_anchorTopLeft, 50, 50, StringToText(""), StringExternal("Param/Value/857C7757"), "");
    libNtve_gf_CreateDialogItemButton(DialogLastCreated(), 200, 50, c_anchorTopLeft, 50, 120, StringToText(""), StringExternal("Param/Value/E1420A2A"), "");
    libNtve_gf_CreateDialogItemButton(DialogLastCreated(), 200, 50, c_anchorTopLeft, 50, 190, StringToText(""), StringExternal("Param/Value/753AF388"), "");
    DialogSetVisible(DialogLastCreated(), PlayerGroupAll(), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BuffChoice_Init () {
    gt_BuffChoice = TriggerCreate("gt_BuffChoice_Func");
    TriggerAddEventTimePeriodic(gt_BuffChoice, 25.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_MeleeInitialization_Init();
    gt_UntitledTrigger002_Init();
    gt_UntitledTrigger003_Init();
    gt_UntitledTrigger004_Init();
    gt_BuffChoice_Init();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    InitLibs();
    InitGlobals();
    InitTriggers();
}
