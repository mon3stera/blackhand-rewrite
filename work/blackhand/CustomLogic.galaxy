//--------------------------------------------------------------------------------------------------
// Trigger: AS - ????????????
//--------------------------------------------------------------------------------------------------
bool gt_ASE4B889E9BB91E7A1AEE5AE9A_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_a;
    int lv_b;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!(((gv_roles[EventPlayer()][1] == 2) || (gv_roles[EventPlayer()][1] == 5)))) {
            return false;
        }

        if (!((EventDialogControl() == gv_e7A1AEE8AEA4E68EA7E4BBB6))) {
            return false;
        }

        if (!((PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_b = DialogControlGetSelectedItem(gv_e8A792E889B2E68EA7E4BBB6, EventPlayer());
    lv_a = gv_roles[EventPlayer()][1];
    if ((lv_b == 12)) {
        lv_b = 14;
    }

    if ((lv_b == 13)) {
        lv_b = 15;
    }

    if (((gv_roleNameArray[lv_a][lv_b] != null) || (lv_b == 15))) {
        if ((gv_roles[EventPlayer()][0] == 14)) {
            if ((lv_b == 14)) {
                gf_CBSystemMessage(StringExternal("Param/Value/E39314B6"), EventPlayer(), 0, 0, SoundLink("Silent", -1), Color(0,0,0));
                return true;
            }

            if (((gv_roleChance[lv_a][lv_b] > 0.0) || (lv_b == 1))) {
                if ((lv_b == 2) && (gv_roleOptions[lv_a][14][0] == false)) {
                    gf_CBSystemMessage(StringExternal("Param/Value/1EFA127B"), EventPlayer(), 0, 0, SoundLink("Silent", -1), Color(0,0,0));
                }
                else {
                    gv_roles[EventPlayer()][0] = lv_b;
                    gv_shots[EventPlayer()] = 1;
                    if ((lv_b == 11)) {
                        if ((gv_roleOptions[lv_a][lv_b][1] == true)) {
                            gv_shots[EventPlayer()] = 3;
                        }
                        else {
                            if ((gv_roleOptions[lv_a][lv_b][2] == true)) {
                                gv_shots[EventPlayer()] = 4;
                            }

                        }
                    }
                    else {
                        if ((lv_b == 6)) {
                            if ((gv_roleOptions[lv_a][lv_b][1] == true)) {
                                gv_shots[EventPlayer()] = 1;
                            }
                            else {
                                if ((gv_roleOptions[lv_a][lv_b][2] == true)) {
                                    gv_shots[EventPlayer()] = 2;
                                }
                                else {
                                    if ((gv_roleOptions[lv_a][lv_b][3] == true)) {
                                        gv_shots[EventPlayer()] = 3;
                                    }

                                }
                            }
                        }

                    }
                    if ((lv_a == 2)) {
                        gf_RTMafiaRoleText(EventPlayer());
                    }
                    else {
                        gf_RTTriadRoleText(EventPlayer());
                    }
                    gf_RefreshRoleBox();
                    gf_ASE8A792E889B2E98089E9A1B9E585B3E997AD(EventPlayer());
                }
            }
            else {
                gf_CBSystemMessage(StringExternal("Param/Value/F6913C93"), EventPlayer(), 0, 0, SoundLink("Silent", -1), Color(0,0,0));
            }
            return true;
        }

        if (((gv_roles[EventPlayer()][0] == 5) || (gv_roles[EventPlayer()][0] == 15))) {
            gv_e8AFACE999B7E98089E68BA9E79A84E8A792E889B2[EventPlayer()] = lv_b;
            gf_CBSystemMessage((StringExternal("Param/Value/E8C3EC2A") + gv_roleNameArray[lv_a][lv_b] + StringExternal("Param/Value/C8D44D9F")), EventPlayer(), 0, 0, SoundLink("Silent", -1), Color(0,0,0));
        }

    }

    return true;
}

