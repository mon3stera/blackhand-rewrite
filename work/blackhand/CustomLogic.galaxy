    CinematicFade(true, 5.0, c_fadeStyleNormal, Color(0.00, 0.00, 0.00), 0.0, false);
    auto70D8CCD2_g = PlayerGroupAll();
    auto70D8CCD2_var = -1;
    while (true) {
        auto70D8CCD2_var = PlayerGroupNextPlayer(auto70D8CCD2_g, auto70D8CCD2_var);
        if (auto70D8CCD2_var < 0) { break; }
        CameraLockInput(auto70D8CCD2_var, false);
    }
    CameraSetBounds(PlayerGroupAll(), RegionFromId(1), false);
    lv_a = 1;
    for ( ; ( (autoFE2BB050_ai >= 0 && lv_a <= autoFE2BB050_ae) || (autoFE2BB050_ai < 0 && lv_a >= autoFE2BB050_ae) ) ; lv_a += autoFE2BB050_ai ) {
        TextTagShow(gv_nameTag[lv_a], PlayerGroupAll(), true);
    }
    Wait(3.0, c_timeGame);
    UIClearMessages(PlayerGroupAll(), c_messageAreaDirective);
    Wait(1.0, c_timeGame);
    TriggerEnable(gt_ADAntiAFKPeriod, true);
    gv_willsAllowed = true;
    DialogSetVisible(gv_lWButton, PlayerGroupAll(), true);
    if ((gv_willsEnabled == true)) {
        DialogControlSetEnabled(gv_lWButtonItem, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetEnabled(gv_lWButtonItem, PlayerGroupAll(), false);
    }
    DialogSetVisible(gv_skipButton, PlayerGroupAll(), true);
    DialogSetVisible(gv_fontButton, PlayerGroupAll(), true);
    DialogSetVisible(gv_switchButton, PlayerGroupAll(), true);
    DialogControlSetEnabled(gv_switchButtonItem, PlayerGroupAll(), false);
    DialogSetVisible(gv_abilityButton, PlayerGroupAll(), true);
    DialogControlSetEnabled(gv_abilityButtonItem, PlayerGroupAll(), false);
    TriggerEnable(gt_ELHotkeys, true);
    if ((gv_startonDay == false)) {
        gf_NightTransition();
    }
    else {
        gf_DayTransition();
    }
    return true;
}

