//--------------------------------------------------------------------------------------------------
void gt_Recap_Init () {
    gt_Recap = TriggerCreate("gt_Recap_Func");
    TriggerAddEventChatMessage(gt_Recap, c_playerAny, "-recap", true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Clear
//--------------------------------------------------------------------------------------------------
bool gt_Clear_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_a;
    int lv_hit;
    int lv_x;

    // Automatic Variable Declarations
    const int auto779F45D7_ae = 15;
    const int auto779F45D7_ai = 1;
    const int auto74D1F1A2_ae = 15;
    const int auto74D1F1A2_ai = 1;
    const int auto814D7D2E_ae = 15;
    const int auto814D7D2E_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((StringSub(EventChatMessage(false), 1, 7) == "-clear "))) {
            return false;
        }

        if (!(((gv_oP[EventPlayer()][3] == true) || (gv_oP[EventPlayer()][6] == true)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_a = 1;
    for ( ; ( (auto779F45D7_ai >= 0 && lv_a <= auto779F45D7_ae) || (auto779F45D7_ai < 0 && lv_a >= auto779F45D7_ae) ) ; lv_a += auto779F45D7_ai ) {
        if ((PlayerGroupHasPlayer(gv_currentPlayers, lv_a) == true) && ((gv_oP[lv_a][3] == false) || (gv_oP[EventPlayer()][1] == true))) {
            if ((StringSub(StringCase(EventChatMessage(false), false), 8, (StringLength(EventChatMessage(false)) + 0)) == StringCase(gv_number[lv_a], false)) && (lv_x < StringLength(gv_number[lv_a]))) {
                lv_x = StringLength(gv_number[lv_a]);
                lv_hit = lv_a;
            }

        }

    }
    if ((lv_hit == 0)) {
        lv_a = 1;
        for ( ; ( (auto74D1F1A2_ai >= 0 && lv_a <= auto74D1F1A2_ae) || (auto74D1F1A2_ai < 0 && lv_a >= auto74D1F1A2_ae) ) ; lv_a += auto74D1F1A2_ai ) {
            if ((PlayerGroupHasPlayer(gv_currentPlayers, lv_a) == true) && ((gv_oP[lv_a][3] == false) || (gv_oP[EventPlayer()][1] == true))) {
