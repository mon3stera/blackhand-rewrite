    lv_b = StringToInt(StringSub(EventChatMessage(false), 6, StringLength(EventChatMessage(false))));
    if ((lv_b >= gv_rouletteMinimumBet)) {
        if ((lv_b <= MaxI((gv_points[EventPlayer()] / 4), 5)) && (lv_b <= 50)) {
            lv_a = 1;
            for ( ; ( (auto523EE787_ai >= 0 && lv_a <= auto523EE787_ae) || (auto523EE787_ai < 0 && lv_a >= auto523EE787_ae) ) ; lv_a += auto523EE787_ai ) {
