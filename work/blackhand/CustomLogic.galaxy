void gf_OSActivateOptions () {
    // Variable Declarations
    int lv_a;

    // Automatic Variable Declarations
    const int auto3F2F85EA_ae = 4;
    const int auto3F2F85EA_ai = 1;

    // Variable Initialization

    // Implementation
    SoundPlay(SoundLink("UI_ObjectiveComplete", -1), PlayerGroupSingle(gv_host), 100.0, 0.0);
    DialogControlSetEnabled(gv_variantsMenuItem[0], PlayerGroupSingle(gv_host), true);
    if ((gv_variantSelection != DialogControlGetSelectedItem(gv_variantsMenuItem[0], gv_host))) {
        DialogControlSetEnabled(gv_variantsMenuItem[1], PlayerGroupSingle(gv_host), true);
    }

    DialogControlSetEnabled(gv_variantDescriptionItem[0], PlayerGroupSingle(gv_host), true);
    DialogControlSetEnabled(gv_variantDescriptionItem[1], PlayerGroupSingle(gv_host), true);
    DialogControlSetEnabled(gv_confirmationButtonItem[0], PlayerGroupSingle(gv_host), true);
    DialogControlSetEnabled(gv_confirmationButtonItem[1], PlayerGroupSingle(gv_host), true);
    if ((gv_variantSelection != 0)) {
        DialogControlSetEnabled(gv_rolesMenusItem[0], PlayerGroupSingle(gv_host), true);
    }

    if ((gv_variantSelection != 0) && (gv_variantSelection != 1) && (gv_variantSelection != 4)) {
        DialogControlSetEnabled(gv_rolesMenusItem[2], PlayerGroupSingle(gv_host), true);
    }

    if ((gv_roleCategory != 0)) {
        DialogControlSetEnabled(gv_rolesMenusItem[1], PlayerGroupSingle(gv_host), true);
    }

    if ((gv_playerSelection != 0)) {
        DialogControlSetEnabled(gv_rolesMenusItem[4], PlayerGroupSingle(gv_host), true);
        if ((gv_playerSelection > 1)) {
            DialogControlSetEnabled(gv_rolesMenusItem[8], PlayerGroupSingle(gv_host), true);
        }

        if ((gv_playerSelection < gv_rolesAssigned)) {
            DialogControlSetEnabled(gv_rolesMenusItem[9], PlayerGroupSingle(gv_host), true);
        }

    }

    if ((gv_roleSelection != 0)) {
        DialogControlSetEnabled(gv_rolePanelItem[0], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_rolePanelItem[1], PlayerGroupSingle(gv_host), true);
        lv_a = 0;
        for ( ; ( (auto3F2F85EA_ai >= 0 && lv_a <= auto3F2F85EA_ae) || (auto3F2F85EA_ai < 0 && lv_a >= auto3F2F85EA_ae) ) ; lv_a += auto3F2F85EA_ai ) {
            if ((gv_roleOptionExists[gv_roleCategory][gv_roleSelection][lv_a] == true) && (gv_roleOptionAllowed[gv_roleCategory][gv_roleSelection][lv_a] == true)) {
                DialogControlSetEnabled(gv_rolePanelItem[(lv_a + 2)], PlayerGroupSingle(gv_host), true);
                DialogControlSetEnabled(gv_rolePanelItem[(lv_a + 7)], PlayerGroupSingle(gv_host), true);
            }

        }
        DialogControlSetEnabled(gv_rolePanelItem[12], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_rolePanelItem[13], PlayerGroupSingle(gv_host), true);
    }

    DialogControlSetEnabled(gv_rolesMenusItem[5], PlayerGroupSingle(gv_host), true);
    DialogControlSetEnabled(gv_rolesMenusItem[6], PlayerGroupSingle(gv_host), true);
    DialogControlSetEnabled(gv_rolesMenusItem[7], PlayerGroupSingle(gv_host), true);
    if ((gv_variantSelection != 0)) {
        DialogControlSetEnabled(gv_optionsPanelItem[1], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[9], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[12], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[2], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[10], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[13], PlayerGroupSingle(gv_host), true);
        if ((gv_variantSelection != 2)) {
            DialogControlSetEnabled(gv_optionsPanelItem[6], PlayerGroupSingle(gv_host), true);
            DialogControlSetEnabled(gv_optionsPanelItem[15], PlayerGroupSingle(gv_host), true);
        }

        DialogControlSetEnabled(gv_optionsPanelItem[3], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[17], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[5], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[18], PlayerGroupSingle(gv_host), true);
        if ((gv_variantSelection != 2)) {
            DialogControlSetEnabled(gv_optionsPanelItem[4], PlayerGroupSingle(gv_host), true);
            DialogControlSetEnabled(gv_optionsPanelItem[19], PlayerGroupSingle(gv_host), true);
        }

        if ((gv_startDayWithDiscussion == true)) {
            DialogControlSetEnabled(gv_optionsPanelItem[7], PlayerGroupSingle(gv_host), true);
            DialogControlSetEnabled(gv_optionsPanelItem[11], PlayerGroupSingle(gv_host), true);
            DialogControlSetEnabled(gv_optionsPanelItem[14], PlayerGroupSingle(gv_host), true);
        }

        if ((gv_lynchType != 0) && (gv_lynchType != 3)) {
            DialogControlSetEnabled(gv_optionsPanelItem[20], PlayerGroupSingle(gv_host), true);
            DialogControlSetEnabled(gv_optionsPanelItem[24], PlayerGroupSingle(gv_host), true);
            DialogControlSetEnabled(gv_optionsPanelItem[25], PlayerGroupSingle(gv_host), true);
            DialogControlSetEnabled(gv_optionsPanelItem[26], PlayerGroupSingle(gv_host), true);
            DialogControlSetEnabled(gv_optionsPanelItem[27], PlayerGroupSingle(gv_host), true);
            DialogControlSetEnabled(gv_optionsPanelItem[28], PlayerGroupSingle(gv_host), true);
            DialogControlSetEnabled(gv_optionsPanelItem[29], PlayerGroupSingle(gv_host), true);
        }

        DialogControlSetEnabled(gv_optionsPanelItem[21], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[22], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[23], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[30], PlayerGroupSingle(gv_host), true);
        DialogControlSetEnabled(gv_optionsPanelItem[31], PlayerGroupSingle(gv_host), true);
    }

}

