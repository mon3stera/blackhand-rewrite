//--------------------------------------------------------------------------------------------------
// Trigger: EL - Event Log Buttons
//--------------------------------------------------------------------------------------------------
bool gt_ELEventLogButtons_Func (bool testConds, bool runActions) {
    int init_i;

    // Variable Declarations
    string[10] lv_str;
    int lv_b;

    // Automatic Variable Declarations
    const int autoE6AC2293_ae = 1;
    const int autoE6AC2293_ai = -1;
    const int auto660D7445_ae = 1;
    const int auto660D7445_ai = -1;

    // Variable Initialization
    for (init_i = 0; init_i <= 9; init_i += 1) {
        lv_str[init_i] = "";
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_eventLogButtonItem) && (gv_eventLogView[EventPlayer()] == false)) {
        DialogSetVisible(gv_eventLogButton, PlayerGroupSingle(EventPlayer()), false);
        if ((gv_deadBox != c_invalidDialogId)) {
            DialogSetVisible(gv_deadBox, PlayerGroupSingle(EventPlayer()), false);
        }

        if ((gv_listBox != c_invalidDialogId)) {
            DialogSetVisible(gv_listBox, PlayerGroupSingle(EventPlayer()), false);
        }

        if ((gv_gameOver == true)) {
            DialogSetVisible(gv_endButton, PlayerGroupSingle(EventPlayer()), false);
        }

        if ((PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true) && (gv_roleBox != c_invalidDialogId)) {
            DialogSetVisible(gv_roleBox, PlayerGroupSingle(EventPlayer()), false);
        }

        DialogSetVisible(gv_eventLog, PlayerGroupSingle(EventPlayer()), true);
        CameraLockInput(EventPlayer(), true);
        gv_eventLogView[EventPlayer()] = true;
    }

    if ((PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true) && (EventDialogControl() == gv_lWButtonItem)) {
        if ((gv_willsAllowed == true) && (gv_willsEnabled == true)) {
            if (((StringLength(gv_lastWill[EventPlayer()][0]) >= 1) || (StringLength(gv_lastWill[EventPlayer()][1]) >= 1))) {
                libNtve_gf_SetDialogItemEditorValue(gv_lastWillBoxItem[0], gv_lastWill[EventPlayer()][0], PlayerGroupSingle(EventPlayer()));
                libNtve_gf_SetDialogItemEditorValue(gv_lastWillBoxItem[1], gv_lastWill[EventPlayer()][1], PlayerGroupSingle(EventPlayer()));
            }
            else {
                libNtve_gf_SetDialogItemEditorValue(gv_lastWillBoxItem[0], "", PlayerGroupSingle(EventPlayer()));
                libNtve_gf_SetDialogItemEditorValue(gv_lastWillBoxItem[1], "", PlayerGroupSingle(EventPlayer()));
            }
            DialogSetVisible(gv_lastWillBox, PlayerGroupSingle(EventPlayer()), true);
        }
        else {
            gf_CBSystemMessage(StringExternal("Param/Value/7258CBD2"), EventPlayer(), EventPlayer(), 0, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
        }
    }

    if ((EventDialogControl() == gv_chatOpButtonItem)) {
        gf_ASToggleGuesses(0);
    }

    if ((EventDialogControl() == gv_fontButtonItem)) {
        if ((gv_magnified[EventPlayer()][0] == false) && (gv_magnified[EventPlayer()][1] == false)) {
            gf_CBMagnifyOnOff(EventPlayer(), ge_Magnify_Magnify);
        }
        else {
            if ((gv_magnified[EventPlayer()][0] == true) && (gv_magnified[EventPlayer()][1] == false)) {
                gf_CBMagnifyOnOff(EventPlayer(), ge_Magnify_SuperMagnify);
            }
            else {
                gf_CBMagnifyOnOff(EventPlayer(), ge_Magnify_Unmagnify);
            }
        }
        lv_str[8] = (libNtve_gf_ConvertBooleanToString(gv_magnified[EventPlayer()][0]) + " " + libNtve_gf_ConvertBooleanToString(gv_magnified[EventPlayer()][1]));
        BankValueSetFromString(gv_bank[EventPlayer()], "I", "Magnify", lv_str[8]);
        BankSave(gv_bank[EventPlayer()]);
    }

    if ((EventDialogControl() == gv_eventLogItemAlt[6]) && (gv_eventLogView[EventPlayer()] == true)) {
        DialogSetVisible(gv_eventLogButton, PlayerGroupSingle(EventPlayer()), true);
        if ((gv_deadBox != c_invalidDialogId)) {
            DialogSetVisible(gv_deadBox, PlayerGroupSingle(EventPlayer()), true);
        }

        if ((gv_listBox != c_invalidDialogId)) {
            DialogSetVisible(gv_listBox, PlayerGroupSingle(EventPlayer()), true);
        }

        if ((gv_gameOver == true)) {
            DialogSetVisible(gv_endButton, PlayerGroupSingle(EventPlayer()), true);
        }

        if ((PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true) && (gv_roleBox != c_invalidDialogId)) {
            DialogSetVisible(gv_roleBox, PlayerGroupSingle(EventPlayer()), true);
        }

        DialogSetVisible(gv_eventLog, PlayerGroupSingle(EventPlayer()), false);
        CameraLockInput(EventPlayer(), false);
        gv_eventLogView[EventPlayer()] = false;
