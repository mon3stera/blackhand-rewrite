//--------------------------------------------------------------------------------------------------
// Trigger: Death Note
//--------------------------------------------------------------------------------------------------
bool gt_DeathNote_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_x;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true))) {
            return false;
        }

        if (!((((gv_roles[EventPlayer()][1] == 2) && ((gv_roles[EventPlayer()][0] == 1) || (gv_roles[EventPlayer()][0] == 2) || (gv_roles[EventPlayer()][0] == 8) || (gv_roles[EventPlayer()][0] == 9) || (gv_roles[EventPlayer()][0] == 14))) || ((gv_roles[EventPlayer()][1] == 5) && ((gv_roles[EventPlayer()][0] == 1) || (gv_roles[EventPlayer()][0] == 2) || (gv_roles[EventPlayer()][0] == 8) || (gv_roles[EventPlayer()][0] == 9) || (gv_roles[EventPlayer()][0] == 14))) || ((gv_roles[EventPlayer()][1] == 3) && ((gv_roles[EventPlayer()][0] == 1) || (gv_roles[EventPlayer()][0] == 4) || (gv_roles[EventPlayer()][0] == 5) || (gv_roles[EventPlayer()][0] == 9) || (gv_roles[EventPlayer()][0] == 14) || (gv_roles[EventPlayer()][0] == 15)))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((StringSub(EventChatMessage(false), 1, 12) == "-death note ")) {
        lv_x = 13;
    }
    else {
        if ((StringSub(EventChatMessage(false), 1, 4) == "-dn ")) {
            lv_x = 5;
        }
        else {
            if ((StringSub(EventChatMessage(false), 1, 11) == "-death note")) {
                lv_x = 99;
            }
            else {
                if ((StringSub(EventChatMessage(false), 1, 3) == "-dn")) {
                    lv_x = 99;
                }

            }
        }
    }
    if ((lv_x != 0) && (PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true)) {
        if ((StringLength(EventChatMessage(false)) < lv_x)) {
            gv_deathNote[EventPlayer()] = null;
            gf_CBSystemMessage(StringExternal("Param/Value/1E6AE593"), EventPlayer(), EventPlayer(), 0, SoundLink("UI_CampaignNPCSelect", -1), Color(0,0,0));
        }
        else {
            gv_deathNote[EventPlayer()] = StringSub(EventChatMessage(false), lv_x, StringLength(EventChatMessage(false)));
            gf_CBSystemMessage(StringExternal("Param/Value/723DE031"), EventPlayer(), EventPlayer(), 0, SoundLink("UI_CampaignNPCSelect", -1), Color(0,0,0));
            gf_CBSystemMessage((StringExternal("Param/Value/49B12538") + StringToText(gv_deathNote[EventPlayer()]) + StringExternal("Param/Value/0BF3A423")), EventPlayer(), EventPlayer(), 0, SoundLink("Silent", -1), Color(0,0,0));
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DeathNote_Init () {
    gt_DeathNote = TriggerCreate("gt_DeathNote_Func");
    TriggerAddEventChatMessage(gt_DeathNote, c_playerAny, "-death note", false);
    TriggerAddEventChatMessage(gt_DeathNote, c_playerAny, "-dn", false);
}

