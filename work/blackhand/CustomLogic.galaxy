    const int auto388E067B_ai = 1;

    // Variable Initialization
    lv_source = EventPlayer();

    // Conditions
    if (testConds) {
        if (!((PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true))) {
            return false;
        }

        if (!((gv_isNight == true))) {
            return false;
        }

        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((StringSub(EventChatMessage(false), 1, 8) == "-punish "))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_a = 0;
    for ( ; ( (autoB0D061EE_ai >= 0 && lv_a <= autoB0D061EE_ae) || (autoB0D061EE_ai < 0 && lv_a >= autoB0D061EE_ae) ) ; lv_a += autoB0D061EE_ai ) {
        if ((gv_inquisitorRandom[lv_a] == lv_source)) {
            lv_a = 1;
            for ( ; ( (auto388E067B_ai >= 0 && lv_a <= auto388E067B_ae) || (auto388E067B_ai < 0 && lv_a >= auto388E067B_ae) ) ; lv_a += auto388E067B_ai ) {
                if ((PlayerGroupHasPlayer(gv_alivePlayers, lv_a) == true) && (PlayerGroupHasPlayer(gv_currentPlayers, lv_a) == true)) {
                    if ((StringSub(StringCase(EventChatMessage(false), false), 9, (StringLength(EventChatMessage(false)) + 0)) == StringCase(gv_number[lv_a], false))) {
                        lv_target = lv_a;
                    }

                }

            }
            if ((lv_target == 0) && (gv_punishSuggest[lv_source] != 0)) {
                gv_punishVotes[gv_punishSuggest[lv_source]] -= 1.0;
                gv_punishSuggest[lv_source] = 0;
                gf_CBSystemMessage((StringExternal("Param/Value/940719E0")), lv_source, lv_source, 0, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
            }

            if ((lv_target > 0)) {
                if ((gv_punishSuggest[lv_source] != lv_target)) {
                    if ((lv_target == lv_source) && (gv_punishSuggest[lv_source] != 0)) {
                        gv_punishVotes[gv_punishSuggest[lv_source]] -= 1.0;
                        gv_punishSuggest[lv_source] = 0;
                        gf_CBSystemMessage((StringExternal("Param/Value/16690457")), lv_source, lv_source, 0, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
                    }
                    else {
                        if ((lv_target != lv_source)) {
                            if ((gv_punishSuggest[lv_source] != 0)) {
                                gf_CBSystemMessage((StringExternal("Param/Value/0B238BA0") + TextWithColor(StringToText(gv_name[lv_target]), libNtve_gf_ConvertPlayerColorToColor(gv_playerColor[lv_target])) + StringExternal("Param/Value/2CAB07A1")), lv_source, lv_source, 0, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
                                gv_punishVotes[gv_punishSuggest[lv_source]] -= 1.0;
                            }
                            else {
                                gf_CBSystemMessage((StringExternal("Param/Value/6CF379E5") + TextWithColor(StringToText(gv_name[lv_target]), libNtve_gf_ConvertPlayerColorToColor(gv_playerColor[lv_target])) + StringExternal("Param/Value/40D8E0E8")), lv_source, lv_source, 0, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
                            }
                            gv_punishSuggest[lv_source] = lv_target;
                            gv_punishVotes[lv_target] += 1.0;
                        }

                    }
                }

            }

        }

    }
    return true;
}

