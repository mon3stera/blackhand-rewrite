                    gf_CBSystemMessage((StringExternal("Param/Value/972465D0") + TextWithColor(StringToText(gv_name[EventPlayer()]), Color(50.20, 50.20, 50.20)) + StringExternal("Param/Value/1A4B1EE7") + IntToText(lv_b) + StringExternal("Param/Value/3C70A48D")), lv_a, 0, 0, SoundLink("UI_ChallengeCountdown", -1), Color(50.20, 0.00, 50.20));
                }

            }
            gv_rouletteBet[EventPlayer()] = lv_b;
