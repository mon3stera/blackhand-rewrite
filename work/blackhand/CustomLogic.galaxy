//--------------------------------------------------------------------------------------------------
// Trigger: UI Buttons
//--------------------------------------------------------------------------------------------------
bool gt_UIButtons_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_a;
    string lv_p;
    int lv_b;
    bool lv_c;
    string lv_s;
    string lv_rename;

    // Automatic Variable Declarations
    int autoF52E1860_ae;
    const int autoF52E1860_ai = 1;
    int auto993D2E20_ae;
    const int auto993D2E20_ai = 1;

    // Variable Initialization
    lv_p = gv_null[EventPlayer()];
    lv_s = "";
    lv_rename = "";

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_roleBoxItem[1])) {
        if ((DialogControlIsVisible(gv_roleBoxItem[3], EventPlayer()) == true)) {
            DialogControlSetVisible(gv_roleBoxItem[3], PlayerGroupSingle(EventPlayer()), false);
            DialogControlSetVisible(gv_roleBoxItem[2], PlayerGroupSingle(EventPlayer()), false);
            libNtve_gf_SetDialogItemTooltip(gv_roleBoxItem[1], StringExternal("Param/Value/9D116228"), PlayerGroupSingle(EventPlayer()));
            DialogControlSetSize(gv_roleBoxItem[0], PlayerGroupSingle(EventPlayer()), 45, 45);
            DialogControlSetPosition(gv_roleBoxItem[4], PlayerGroupSingle(EventPlayer()), c_anchorTopRight, 0, 45);
            DialogControlSetPosition(gv_roleBoxItem[5], PlayerGroupSingle(EventPlayer()), c_anchorTopRight, 10, 55);
            DialogControlSetPosition(gv_roleBoxItem[6], PlayerGroupSingle(EventPlayer()), c_anchorTopRight, 0, 45);
        }
        else {
            DialogControlSetVisible(gv_roleBoxItem[3], PlayerGroupSingle(EventPlayer()), true);
            DialogControlSetVisible(gv_roleBoxItem[2], PlayerGroupSingle(EventPlayer()), true);
            libNtve_gf_SetDialogItemTooltip(gv_roleBoxItem[1], StringExternal("Param/Value/97B1CB7A"), PlayerGroupSingle(EventPlayer()));
            DialogControlSetSize(gv_roleBoxItem[0], PlayerGroupSingle(EventPlayer()), 400, 550);
            DialogControlSetPosition(gv_roleBoxItem[4], PlayerGroupSingle(EventPlayer()), c_anchorTopRight, 400, 250);
            DialogControlSetPosition(gv_roleBoxItem[5], PlayerGroupSingle(EventPlayer()), c_anchorBottomLeft, 10, 10);
            DialogControlSetPosition(gv_roleBoxItem[6], PlayerGroupSingle(EventPlayer()), c_anchorBottomLeft, 270, 270);
        }
    }

    if ((EventDialogControl() == gv_roleBoxItem[6])) {
        if ((gv_minimizedAllies[EventPlayer()] == false)) {
            gv_minimizedAllies[EventPlayer()] = true;
            DialogControlSetVisible(gv_roleBoxItem[5], PlayerGroupSingle(EventPlayer()), false);
            libNtve_gf_SetDialogItemTooltip(gv_roleBoxItem[6], StringExternal("Param/Value/01B01D78"), PlayerGroupSingle(EventPlayer()));
            DialogControlSetSize(gv_roleBoxItem[4], PlayerGroupSingle(EventPlayer()), 30, 30);
        }
        else {
            gv_minimizedAllies[EventPlayer()] = false;
            DialogControlSetVisible(gv_roleBoxItem[5], PlayerGroupSingle(EventPlayer()), true);
            libNtve_gf_SetDialogItemTooltip(gv_roleBoxItem[6], StringExternal("Param/Value/15795FB8"), PlayerGroupSingle(EventPlayer()));
            DialogControlSetSize(gv_roleBoxItem[4], PlayerGroupSingle(EventPlayer()), 300, 300);
        }
    }

    if ((EventDialogControl() == gv_deadBoxItem[1])) {
        if ((DialogControlIsVisible(gv_deadBoxItem[3], EventPlayer()) == true)) {
            DialogControlSetVisible(gv_deadBoxItem[3], PlayerGroupSingle(EventPlayer()), false);
            libNtve_gf_SetDialogItemTooltip(gv_deadBoxItem[1], StringExternal("Param/Value/853BE6AE"), PlayerGroupSingle(EventPlayer()));
            DialogControlSetSize(gv_deadBoxItem[0], PlayerGroupSingle(EventPlayer()), 350, 45);
        }
        else {
            DialogControlSetVisible(gv_deadBoxItem[3], PlayerGroupSingle(EventPlayer()), true);
            libNtve_gf_SetDialogItemTooltip(gv_deadBoxItem[1], StringExternal("Param/Value/F7361A9D"), PlayerGroupSingle(EventPlayer()));
            DialogControlSetSize(gv_deadBoxItem[0], PlayerGroupSingle(EventPlayer()), 350, 400);
        }
    }

    if ((EventDialogControl() == gv_listBoxItem[1])) {
        if ((DialogControlIsVisible(gv_listBoxItem[3], EventPlayer()) == true)) {
            DialogControlSetVisible(gv_listBoxItem[3], PlayerGroupSingle(EventPlayer()), false);
            libNtve_gf_SetDialogItemTooltip(gv_listBoxItem[1], StringExternal("Param/Value/D1E293DB"), PlayerGroupSingle(EventPlayer()));
            DialogControlSetSize(gv_listBoxItem[0], PlayerGroupSingle(EventPlayer()), 250, 45);
        }
        else {
            DialogControlSetVisible(gv_listBoxItem[3], PlayerGroupSingle(EventPlayer()), true);
            libNtve_gf_SetDialogItemTooltip(gv_listBoxItem[1], StringExternal("Param/Value/CD9EEABD"), PlayerGroupSingle(EventPlayer()));
            DialogControlSetSize(gv_listBoxItem[0], PlayerGroupSingle(EventPlayer()), 250, 400);
        }
    }

    if ((EventDialogControl() == gv_menuButtonItem)) {
        UIShowCustomMenu(PlayerGroupSingle(EventPlayer()), StringExternal("Param/Value/ECE60EB5"));
    }

    if ((EventDialogControl() == gv_helpButtonItem)) {
        HelpPanelDisplayPage(PlayerGroupSingle(EventPlayer()), c_helpPanelPageTips);
    }

    if ((EventDialogControl() == gv_endButtonItem) && (gv_gameOver == true)) {
        if ((gv_won[EventPlayer()] == true)) {
            GameOver(EventPlayer(), c_gameOverVictory, true, true);
        }
        else {
            GameOver(EventPlayer(), c_gameOverDefeat, true, true);
        }
    }

    if ((EventDialogControl() == gv_leaderboardItem[1]) && (gv_leaderboardName[EventPlayer()] == "")) {
        lv_s = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
        if ((StringLength(libNtve_gf_DialogItemEditValue(gv_leaderboardItem[0], EventPlayer())) > 12)) {
            gf_CBSystemMessage(StringExternal("Param/Value/013EE4CB"), EventPlayer(), 0, 0, SoundLink("UI_GenericError", -1), Color(0,0,0));
        }
        else {
            if ((StringLength(libNtve_gf_DialogItemEditValue(gv_leaderboardItem[0], EventPlayer())) <= 1)) {
                gf_CBSystemMessage(StringExternal("Param/Value/2FA6D35B"), EventPlayer(), 0, 0, SoundLink("UI_GenericError", -1), Color(0,0,0));
            }
            else {
                if ((StringCase(libNtve_gf_DialogItemEditValue(gv_leaderboardItem[1], EventPlayer()), false) == "darkrevenant")) {
                    gf_CBSystemMessage(StringExternal("Param/Value/A4D8DBED"), EventPlayer(), 0, 0, SoundLink("UI_GenericError", -1), Color(0,0,0));
                }
                else {
                    gv_leaderboardName[EventPlayer()] = libNtve_gf_DialogItemEditValue(gv_leaderboardItem[0], EventPlayer());
                    autoF52E1860_ae = StringLength(gv_leaderboardName[EventPlayer()]);
                    lv_b = 1;
                    for ( ; ( (autoF52E1860_ai >= 0 && lv_b <= autoF52E1860_ae) || (autoF52E1860_ai < 0 && lv_b >= autoF52E1860_ae) ) ; lv_b += autoF52E1860_ai ) {
                        lv_c = false;
                        auto993D2E20_ae = StringLength(lv_s);
                        lv_a = 1;
                        for ( ; ( (auto993D2E20_ai >= 0 && lv_a <= auto993D2E20_ae) || (auto993D2E20_ai < 0 && lv_a >= auto993D2E20_ae) ) ; lv_a += auto993D2E20_ai ) {
                            if ((StringSub(gv_leaderboardName[EventPlayer()], lv_b, lv_b) == StringSub(lv_s, lv_a, lv_a))) {
                                lv_c = true;
                            }

                        }
                        if ((lv_c == false)) {
                            gf_CBSystemMessage(StringExternal("Param/Value/8E152631"), EventPlayer(), 0, 0, SoundLink("UI_GenericError", -1), Color(0,0,0));
                            gv_leaderboardName[EventPlayer()] = "";
                            break;
                        }

                    }
                }
            }
        }
        if ((gv_leaderboardName[EventPlayer()] != "")) {
            gv_verified[EventPlayer()] = true;
            gv_bankGeneralStrings[EventPlayer()][0] = gv_leaderboardName[EventPlayer()];
            gf_CBSystemMessage((StringExternal("Param/Value/A8653BB2") + StringToText(gv_leaderboardName[EventPlayer()]) + StringExternal("Param/Value/D3A5548F")), EventPlayer(), 16, 0, SoundLink("UI_ObjectiveBonusDiscovered", -1), Color(0,0,0));
            DialogSetVisible(gv_leaderboard, PlayerGroupSingle(EventPlayer()), false);
            gf_CAssembleMainBank(EventPlayer());
        }

    }

    if ((EventDialogControl() == gv_lastWillBoxItem[2]) && (gv_willsEnabled == true)) {
        if ((PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true)) {
            if ((gv_willsAllowed == true)) {
                gv_lastWill[EventPlayer()][0] = libNtve_gf_DialogItemEditValue(gv_lastWillBoxItem[0], EventPlayer());
                gv_lastWill[EventPlayer()][1] = libNtve_gf_DialogItemEditValue(gv_lastWillBoxItem[1], EventPlayer());
                gf_CBSystemMessage(StringExternal("Param/Value/AFF5A71F"), EventPlayer(), EventPlayer(), 0, SoundLink("UI_CampaignHintNotify", -1), Color(0,0,0));
                gf_CBSystemMessage((StringExternal("Param/Value/5B389404") + StringToText(gv_lastWill[EventPlayer()][0]) + StringExternal("Param/Value/0085779F")), EventPlayer(), EventPlayer(), 0, SoundLink("Silent", -1), Color(0,0,0));
                gf_CBSystemMessage((StringExternal("Param/Value/A41D6B99") + StringToText(gv_lastWill[EventPlayer()][1]) + StringExternal("Param/Value/0319D50B")), EventPlayer(), EventPlayer(), 0, SoundLink("Silent", -1), Color(0,0,0));
                DialogSetVisible(gv_lastWillBox, PlayerGroupSingle(EventPlayer()), false);
            }
            else {
                gf_CBSystemMessage(StringExternal("Param/Value/73D0230B"), EventPlayer(), 0, 0, SoundLink("UI_GenericError", -1), Color(0,0,0));
            }
        }
        else {
            DialogSetVisible(gv_lastWillBox, PlayerGroupSingle(EventPlayer()), false);
        }
    }

    if ((EventDialogControl() == gv_save64BoxItem[2])) {
        gv_save64[EventPlayer()] = libNtve_gf_DialogItemEditValue(gv_save64BoxItem[0], EventPlayer());
        DialogSetVisible(gv_save64Box, PlayerGroupSingle(EventPlayer()), false);
        if ((gv_gameSetup == true) && (gv_host == EventPlayer())) {
            gf_OSLoadBase64(EventPlayer());
        }

    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UIButtons_Init () {
    gt_UIButtons = TriggerCreate("gt_UIButtons_Func");
    TriggerAddEventDialogControl(gt_UIButtons, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

