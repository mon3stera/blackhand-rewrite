//--------------------------------------------------------------------------------------------------
void gt_MOD2_Init () {
    gt_MOD2 = TriggerCreate("gt_MOD2_Func");
    TriggerAddEventChatMessage(gt_MOD2, c_playerAny, "-bloody hell", true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Recap
//--------------------------------------------------------------------------------------------------
bool gt_Recap_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_a;
    int lv_b;
    int lv_c;

    // Automatic Variable Declarations
    const int autoE2AF03C6_ae = 15;
    const int autoE2AF03C6_ai = 1;
    const int autoBBFAB216_ae = 15;
    const int autoBBFAB216_ai = 1;
    const int auto9DA2BCC3_ae = 15;
    const int auto9DA2BCC3_ai = 1;
    int auto864BA472_ae;
    const int auto864BA472_ai = 1;
    const int auto6FF1C952_ae = 15;
    const int auto6FF1C952_ai = 1;

    // Variable Initialization
    lv_a = EventPlayer();

    // Conditions
    if (testConds) {
        if (!((gv_gameOver == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_b = 1;
    for ( ; ( (autoE2AF03C6_ai >= 0 && lv_b <= autoE2AF03C6_ae) || (autoE2AF03C6_ai < 0 && lv_b >= autoE2AF03C6_ae) ) ; lv_b += autoE2AF03C6_ai ) {
        if ((PlayerGroupHasPlayer(gv_players, lv_b) == true)) {
            gf_CBSystemMessage((StringExternal("Param/Value/A4248395") + StringToText(gv_number[lv_b]) + StringExternal("Param/Value/6192624D") + TextWithColor(StringToText(gv_name[lv_b]), libNtve_gf_ConvertPlayerColorToColor(gv_playerColor[lv_b])) + StringExternal("Param/Value/FC306C5F") + PlayerName(lv_b) + StringExternal("Param/Value/6EF3BE5F") + StringToText(PlayerHandle(lv_b)) + StringExternal("Param/Value/F45FC7AB") + gv_roleNameArray[gv_roles[lv_b][1]][gv_roles[lv_b][0]] + StringExternal("Param/Value/545E406F")), lv_a, 0, -1, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
        }

    }
    lv_b = 1;
    for ( ; ( (autoBBFAB216_ai >= 0 && lv_b <= autoBBFAB216_ae) || (autoBBFAB216_ai < 0 && lv_b >= autoBBFAB216_ae) ) ; lv_b += autoBBFAB216_ai ) {
        if ((PlayerGroupHasPlayer(gv_players, lv_b) == true)) {
            lv_c = 1;
            for ( ; ( (auto9DA2BCC3_ai >= 0 && lv_c <= auto9DA2BCC3_ae) || (auto9DA2BCC3_ai < 0 && lv_c >= auto9DA2BCC3_ae) ) ; lv_c += auto9DA2BCC3_ai ) {
                if ((gv_reported[lv_b][lv_c] == true)) {
                    gf_CBSystemMessage((StringExternal("Param/Value/7EED331A") + TextWithColor(PlayerName(lv_b), libNtve_gf_ConvertPlayerColorToColor(gv_playerColor[lv_b])) + StringExternal("Param/Value/63A04FF3") + TextWithColor(PlayerName(lv_c), libNtve_gf_ConvertPlayerColorToColor(gv_playerColor[lv_c])) + StringExternal("Param/Value/4BCBF3A9")), lv_a, 0, -1, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
                }

            }
        }

    }
    auto864BA472_ae = gv_dayNumber;
    lv_c = 1;
    for ( ; ( (auto864BA472_ai >= 0 && lv_c <= auto864BA472_ae) || (auto864BA472_ai < 0 && lv_c >= auto864BA472_ae) ) ; lv_c += auto864BA472_ai ) {
        gf_CBSystemMessage((StringExternal("Param/Value/5D6B249D") + IntToText(lv_c) + StringExternal("Param/Value/469B9FB4")), lv_a, 0, -1, SoundLink("Silent", -1), Color(39.22, 19.61, 58.82));
        lv_b = 1;
        for ( ; ( (auto6FF1C952_ai >= 0 && lv_b <= auto6FF1C952_ae) || (auto6FF1C952_ai < 0 && lv_b >= auto6FF1C952_ae) ) ; lv_b += auto6FF1C952_ai ) {
