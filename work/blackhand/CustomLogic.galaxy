//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void SH_InitMap () {
    SH_InitLibs();
    SH_InitGlobals();
    SH_InitCustomScript();
    SH_InitTriggers();
}


//==============================================================
// 发布用入口（史官图）：编辑器生成的 MapScript.galaxy 会自己定义
// InitLibs/InitGlobals/InitTriggers/InitMap，所以本文件里的同名函数
// 全部改名为 SH_*，由触发器里的“自定义脚本”动作调用 SH_InitAll()。
//     include "CustomGameScript"
//     SH_InitAll();
//==============================================================
void SH_InitAll () {
    // 只调用一次完整初始化；SH_InitMap 内部已依次执行
    // SH_InitLibs / SH_InitGlobals / SH_InitCustomScript / SH_InitTriggers。
    // 早期版本在这里重复调用，导致触发器注册两次、UI 与逻辑全部翻倍。
    SH_InitMap();
}

