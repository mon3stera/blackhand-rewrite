    }

    gf_SequenceAfter();
    gf_SequenceAfter2();
    if ((gv_iTSCHRISTMAS == false)) {
        SoundStop(gv_music[0], true);
    }

    Wait(4.0, c_timeGame);
    gv_dayNumber += 1;
    gv_nightEvents = false;
    auto7B711494_g = PlayerGroupAll();
    auto7B711494_var = -1;
    while (true) {
        auto7B711494_var = PlayerGroupNextPlayer(auto7B711494_g, auto7B711494_var);
        if (auto7B711494_var < 0) { break; }
        CameraLockInput(auto7B711494_var, false);
    }
    SoundSetReverb("Off", 0.0, false, true);
    gf_DEBUG("Finished night handler");
    gf_DayTransition();
    return true;
}

