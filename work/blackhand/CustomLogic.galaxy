//--------------------------------------------------------------------------------------------------
// Trigger: Wandering Civs
//--------------------------------------------------------------------------------------------------
bool gt_WanderingCivs_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_x;

    // Automatic Variable Declarations
    unitgroup auto8C3156E5_g;
    int auto8C3156E5_u;
    unit auto8C3156E5_var;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    auto8C3156E5_g = UnitGroup(null, 0, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto8C3156E5_u = UnitGroupCount(auto8C3156E5_g, c_unitCountAll);
    for (;; auto8C3156E5_u -= 1) {
        auto8C3156E5_var = UnitGroupUnitFromEnd(auto8C3156E5_g, auto8C3156E5_u);
        if (auto8C3156E5_var == null) { break; }
        if (((UnitGetType(auto8C3156E5_var) == "CivilianFemale") || (UnitGetType(auto8C3156E5_var) == "Civilian") || (UnitGetType(auto8C3156E5_var) == "MinerMale") || (UnitGetType(auto8C3156E5_var) == "Scientist")) && (libNtve_gf_UnitIsPaused(auto8C3156E5_var) == false)) {
            lv_x = RandomInt(0, 15);
            if ((lv_x == 15)) {
                UnitIssueOrder(auto8C3156E5_var, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(auto8C3156E5_var), RandomFixed(1.0, 3.0), libNtve_gf_RandomAngle())), c_orderQueueReplace);
            }
            else {
                if ((lv_x >= 13)) {
                    UnitSetFacing(auto8C3156E5_var, libNtve_gf_RandomAngle(), 0.75);
                }
                else {
                    UnitIssueOrder(auto8C3156E5_var, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
                }
            }
        }

    }
    return true;
}

