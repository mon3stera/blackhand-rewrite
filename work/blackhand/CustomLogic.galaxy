//--------------------------------------------------------------------------------------------------
// Trigger: Magnify
//--------------------------------------------------------------------------------------------------
bool gt_Magnify_Func (bool testConds, bool runActions) {
    int init_i;

    // Variable Declarations
    string[10] lv_str;

    // Automatic Variable Declarations
    // Variable Initialization
    for (init_i = 0; init_i <= 9; init_i += 1) {
        lv_str[init_i] = "";
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventChatMessage(false) == "-magnify")) {
        if ((gv_magnified[EventPlayer()][0] == true) && (gv_magnified[EventPlayer()][1] == false)) {
            gf_CBMagnifyOnOff(EventPlayer(), ge_Magnify_Unmagnify);
        }
        else {
            gf_CBMagnifyOnOff(EventPlayer(), ge_Magnify_Magnify);
        }
        lv_str[8] = (libNtve_gf_ConvertBooleanToString(gv_magnified[EventPlayer()][0]) + " " + libNtve_gf_ConvertBooleanToString(gv_magnified[EventPlayer()][1]));
        BankValueSetFromString(gv_bank[EventPlayer()], "I", "Magnify", lv_str[8]);
        BankSave(gv_bank[EventPlayer()]);
    }

    if ((EventChatMessage(false) == "-magnify large")) {
        if ((gv_magnified[EventPlayer()][0] == true) && (gv_magnified[EventPlayer()][1] == true)) {
            gf_CBMagnifyOnOff(EventPlayer(), ge_Magnify_Unmagnify);
        }
        else {
            gf_CBMagnifyOnOff(EventPlayer(), ge_Magnify_SuperMagnify);
        }
        lv_str[8] = (libNtve_gf_ConvertBooleanToString(gv_magnified[EventPlayer()][0]) + " " + libNtve_gf_ConvertBooleanToString(gv_magnified[EventPlayer()][1]));
        BankValueSetFromString(gv_bank[EventPlayer()], "I", "Magnify", lv_str[8]);
        BankSave(gv_bank[EventPlayer()]);
    }

    return true;
}

