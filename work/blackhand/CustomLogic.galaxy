//--------------------------------------------------------------------------------------------------
bool gt_OptionsTimer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerStop(gt_OSStartGame);
    gf_OSCloseOptionsScreen();
    if ((gf_OSCheckOptionsA(true) == true)) {
        gf_OSComputeOptions(ge_Options_Selected);
    }
    else {
        gf_OSComputeOptions(ge_Options_Default);
    }
    return true;
}

