bool gt_Suicide_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(gt_Type) == true))) {
            return false;
        }

        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_suiciding[EventPlayer()][1] == false)) {
        gv_suiciding[EventPlayer()][1] = true;
        gf_CBSystemMessage(StringExternal("Param/Value/1C563116"), EventPlayer(), EventPlayer(), 0, SoundLink("UI_CampaignHintNotify", -1), Color(0,0,0));
