        gf_CBSystemMessage(StringExternal("Param/Value/F701AD4C"), gv_bondedwith[lv_target], gv_bondedwith[lv_target], 0, SoundLink("UI_TipSelect", -1), Color(0,0,0));
        gf_DEBUG("shw93 plague bonder handler");
        gv_damage[gv_bondedwith[lv_target]] += 1;
        gf_ESLBSuicide2(gv_bondedwith[lv_target], gv_bondedby[gv_bondedwith[lv_target]]);
    }
    gf_CBSystemMessage(StringExternal("Param/Value/6082ED42"), lv_target, lv_target, 0, SoundLink("UI_TipSelect", -1), Color(0,0,0));
    Wait(RandomFixed(1.0, 2.0), c_timeGame);
}

