void SH_InitGlobals () {
    int init_i;
    int init_j;
    int init_k;

    gv_diceplayers = PlayerGroupEmpty();
    for (init_i = 0; init_i <= 16; init_i += 1) {
        gv_rouletteBet[init_i] = 5;
    }
    gv_rouletteMinimumBet = 5;
    gv_rouletteSize = 6;
