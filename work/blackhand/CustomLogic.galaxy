//--------------------------------------------------------------------------------------------------
// Trigger: Notanoob
//--------------------------------------------------------------------------------------------------
bool gt_Notanoob_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_noobMode[EventPlayer()] == true))) {
            return false;
        }

        if (!((gv_points[EventPlayer()] < 200))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_CBSystemMessage(StringExternal("Param/Value/81FE767C"), EventPlayer(), EventPlayer(), 0, SoundLink("Silent", -1), Color(0,0,0));
    gf_CBSystemMessage((StringExternal("Param/Value/8CB49327") + IntToText((200 - gv_points[EventPlayer()])) + StringExternal("Param/Value/6998537C")), EventPlayer(), 0, 0, SoundLink("UI_BNet_Achievement", -1), Color(0,0,0));
    gv_bankGeneralIntegers[EventPlayer()][3] = 200;
    gv_points[EventPlayer()] = 200;
    gv_noobMode[EventPlayer()] = false;
    gf_CAssembleMainBank(EventPlayer());
    return true;
}

