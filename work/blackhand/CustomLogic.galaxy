// Trigger: OS - Start Game
//--------------------------------------------------------------------------------------------------
bool gt_OSStartGame_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_a;
    int[2] lv_b;
    int lv_c;

    // Automatic Variable Declarations
    playergroup autoF8101AE3_g;
    int autoF8101AE3_var;
    const int autoD59F1BD4_ae = 15;
    const int autoD59F1BD4_ai = 1;
    int auto94676101_ae;
    const int auto94676101_ai = 1;
    playergroup autoBBEFA17F_g;
    int autoBBEFA17F_var;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((EventPlayer() == gv_host))) {
            return false;
        }

        if (!((EventDialogControl() == gv_confirmationButtonItem[0]))) {
            return false;
        }

        if (!((TriggerIsEnabled(gt_OSStartGame) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_variantSelection == 1)) {
        gv_rolesAssigned = PlayerGroupCount(gv_currentPlayers);
    }

    if ((gv_variantSelection == 1) && (PlayerGroupCount(gv_currentPlayers) >= 4)) {
    }
    else {
        if ((gv_variantSelection != 1)) {
            TriggerEnable(gt_OSStartGame, false);
            if ((gf_OSCheckOptionsA(true) == true)) {
                TriggerEnable(gt_OSStartGame, true);
            }
            else {
                TriggerEnable(gt_OSStartGame, true);
                return true;
            }
        }

    }
    TriggerEnable(gt_OSStartGame, false);
    autoF8101AE3_g = gv_players;
    autoF8101AE3_var = -1;
    while (true) {
        autoF8101AE3_var = PlayerGroupNextPlayer(autoF8101AE3_g, autoF8101AE3_var);
        if (autoF8101AE3_var < 0) { break; }
        gf_CBSystemMessage(StringExternal("Param/Value/7830842D"), autoF8101AE3_var, 0, 0, SoundLink("UI_IdleWorkerSelect", -1), Color(0.00, 39.22, 0.00));
        gf_CBSystemMessage(StringExternal("Param/Value/76AF7269"), autoF8101AE3_var, 0, 0, SoundLink("Silent", -1), Color(0.00, 39.22, 0.00));
    }
    libNtve_gf_SetDialogItemText(gv_confirmationButtonItem[0], StringExternal("Param/Value/2BDAE8BB"), PlayerGroupAll());
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, (StringExternal("Param/Value/154A95F4") + TextWithColor(PlayerName(gv_host), libNtve_gf_ConvertPlayerColorToColor(gv_playerColor[gv_host])) + StringExternal("Param/Value/C1534149")));
    TriggerEnable(gt_RepickHost, true);
    TriggerEnable(gt_RepickHostButtonEFBC9F, true);
    DialogControlSetEnabled(gv_repickButtonItem, PlayerGroupAll(), true);
    TriggerEnable(gt_RepickHostSpecifically, true);
    TriggerEnable(gt_Default, true);
    Wait(0.25, c_timeGame);
    TriggerEnable(gt_OSCancelGame, true);
    Wait(15.0, c_timeGame);
    if ((gv_variantSelection == 1)) {
        DialogControlRemoveAllItems(gv_rolesMenusItem[0], PlayerGroupAll());
        DialogControlRemoveAllItems(gv_rolesMenusItem[1], PlayerGroupAll());
        DialogControlRemoveAllItems(gv_rolesMenusItem[2], PlayerGroupAll());
        gv_rolesAssigned = 0;
        lv_a = 1;
        for ( ; ( (autoD59F1BD4_ai >= 0 && lv_a <= autoD59F1BD4_ae) || (autoD59F1BD4_ai < 0 && lv_a >= autoD59F1BD4_ae) ) ; lv_a += autoD59F1BD4_ai ) {
            gv_rolesArray[lv_a] = 0;
            gv_categoriesArray[lv_a] = 0;
        }
        gf_VSetupoftheDaySetup();
        auto94676101_ae = PlayerGroupCount(gv_currentPlayers);
        lv_a = 1;
        for ( ; ( (auto94676101_ai >= 0 && lv_a <= auto94676101_ae) || (auto94676101_ai < 0 && lv_a >= auto94676101_ae) ) ; lv_a += auto94676101_ai ) {
            lv_b[0] = gv_rolesArray[lv_a];
            lv_b[1] = gv_categoriesArray[lv_a];
            lv_c = lv_a;
            while (((lv_c > 1) && gf_OSRoleLessThan(lv_b[0], lv_b[1], gv_rolesArray[(lv_c - 1)], gv_categoriesArray[(lv_c - 1)]))) {
                gv_rolesArray[lv_c] = gv_rolesArray[(lv_c - 1)];
                gv_categoriesArray[lv_c] = gv_categoriesArray[(lv_c - 1)];
                lv_c = (lv_c - 1);
            }
            gv_rolesArray[lv_c] = lv_b[0];
            gv_categoriesArray[lv_c] = lv_b[1];
        }
        if ((gf_OSCheckOptionsA(true) == true)) {
            gf_OSCloseOptionsScreen();
            gf_OSComputeOptions(ge_Options_Selected);
        }
        else {
            TriggerEnable(gt_OSCancelGame, false);
            libNtve_gf_SetDialogItemText(gv_confirmationButtonItem[0], StringExternal("Param/Value/2A2D40FC"), PlayerGroupAll());
            if ((gv_variant == "sotd")) {
                autoBBEFA17F_g = gv_currentPlayers;
                autoBBEFA17F_var = -1;
                while (true) {
                    autoBBEFA17F_var = PlayerGroupNextPlayer(autoBBEFA17F_g, autoBBEFA17F_var);
                    if (autoBBEFA17F_var < 0) { break; }
                    gf_CBSystemMessage((StringExternal("Param/Value/F388DC57") + gv_setupInfo[1] + StringExternal("Param/Value/9BE4EAE7")), autoBBEFA17F_var, 0, 0, SoundLink("Silent", -1), Color(0,0,0));
                }
            }

            Wait(0.25, c_timeGame);
            gf_VSetupoftheDayOptions();
            TriggerEnable(gt_OSStartGame, true);
        }
    }
    else {
        if ((gf_OSCheckOptionsA(true) == true)) {
            gf_OSCloseOptionsScreen();
            gf_OSComputeOptions(ge_Options_Selected);
        }
        else {
            TriggerEnable(gt_OSCancelGame, false);
            libNtve_gf_SetDialogItemText(gv_confirmationButtonItem[0], StringExternal("Param/Value/3E03AC30"), PlayerGroupAll());
            Wait(0.25, c_timeGame);
            TriggerEnable(gt_OSStartGame, true);
        }
    }
    return true;
}

