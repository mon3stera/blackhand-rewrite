void gf_FlashScreen (color lp_color, int lp_player, fixed lp_duration, fixed lp_alpha) {
    auto_gf_FlashScreen_lp_color = lp_color;
    auto_gf_FlashScreen_lp_player = lp_player;
    auto_gf_FlashScreen_lp_duration = lp_duration;
    auto_gf_FlashScreen_lp_alpha = lp_alpha;

    if (auto_gf_FlashScreen_Trigger == null) {
        auto_gf_FlashScreen_Trigger = TriggerCreate("auto_gf_FlashScreen_TriggerFunc");
    }

    TriggerExecute(auto_gf_FlashScreen_Trigger, false, false);
}

bool auto_gf_FlashScreen_TriggerFunc (bool testConds, bool runActions) {
    color lp_color = auto_gf_FlashScreen_lp_color;
    int lp_player = auto_gf_FlashScreen_lp_player;
    fixed lp_duration = auto_gf_FlashScreen_lp_duration;
    fixed lp_alpha = auto_gf_FlashScreen_lp_alpha;

    // Automatic Variable Declarations
    // Implementation
    gv_showingFlash[lp_player][0] = true;
    DialogSetVisible(gv_screenFlash, PlayerGroupSingle(lp_player), true);
    libNtve_gf_SetDialogItemColor(gv_screenFlashItem[0], lp_color, PlayerGroupSingle(lp_player));
    DialogControlFadeTransparency(gv_screenFlashItem[0], PlayerGroupSingle(lp_player), 0.0, lp_alpha);
    Wait((lp_duration / 2.0), c_timeGame);
    gv_showingFlash[lp_player][0] = false;
    DialogControlFadeTransparency(gv_screenFlashItem[0], PlayerGroupSingle(lp_player), (lp_duration / 2.0), 100.0);
    Wait((lp_duration / 2.0), c_timeGame);
    Wait(0.0, c_timeGame);
    if ((gv_showingFlash[lp_player][0] == false) && (gv_showingFlash[lp_player][1] == false)) {
        DialogSetVisible(gv_screenFlash, PlayerGroupSingle(lp_player), false);
    }

    return true;
}

