        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_b = DialogControlGetSelectedItem(gv_e8A792E889B2E68EA7E4BBB6, EventPlayer());
    lv_a = gv_e5AEA1E69FA5E998B5E890A5E98089E68BA9[EventPlayer()];
    if ((gv_e5AEA1E69FA5E998B5E890A5E98089E68BA9[EventPlayer()] == 1) && (gv_e5AEA1E69FA5E8A792E889B2E98089E68BA9[EventPlayer()] >= 22)) {
        lv_b += 1;
    }

    if ((gv_e5AEA1E69FA5E998B5E890A5E98089E68BA9[EventPlayer()] == 1) && (gv_e5AEA1E69FA5E8A792E889B2E98089E68BA9[EventPlayer()] >= 30)) {
        lv_b -= 1;
