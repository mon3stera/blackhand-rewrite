//--------------------------------------------------------------------------------------------------
// Trigger: Run checker
//--------------------------------------------------------------------------------------------------
bool gt_Runchecker_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gf_CBSystemMessage(IntToText(gv_checka[EventPlayer()]), EventPlayer(), 0, 0, SoundLink("EditorDefaultSound", -1), Color(0,0,0));
    if ((gv_checka[EventPlayer()] == ((gv_points[EventPlayer()] + 1) * (gv_points[EventPlayer()] + 3)))) {
        gf_CBSystemMessage(StringExternal("Param/Value/F434EA74"), EventPlayer(), 0, 0, SoundLink("EditorDefaultSound", -1), Color(0,0,0));
    }
    else {
        gf_CBSystemMessage(StringExternal("Param/Value/F7A4D175"), EventPlayer(), 0, 0, SoundLink("EditorDefaultSound", -1), Color(0,0,0));
    }
    return true;
}

