//--------------------------------------------------------------------------------------------------
// Trigger: AD - Anti-AFK
//--------------------------------------------------------------------------------------------------
bool gt_ADAntiAFK_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true) || (gv_gameStarted == false)))) {
            return false;
        }

        if (!((PlayerGroupHasPlayer(gv_currentPlayers, EventPlayer()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_aFK[EventPlayer()] >= 480) && (gv_aFK[EventPlayer()] < 720)) {
        gf_CBSystemMessage(StringExternal("Param/Value/E50BE443"), EventPlayer(), EventPlayer(), 0, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
    }

    if ((gv_aFK[EventPlayer()] >= 720)) {
    }
    else {
        gv_aFK[EventPlayer()] = 0;
    }
    return true;
}

