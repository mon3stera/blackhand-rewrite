                else {
                    if ((lv_x <= 6)) {
                        GameSetToDLighting("Foggy");
                        gv_lighting = "Foggy";
                        gv_waterLevel += 0.5;
                        FogSetColor(Color(33.73, 45.10, 57.25));
                        FogSetDensity(0.04);
                        FogSetFallOff(0.03);
                        FogSetStartHeight(-10.0);
                    }
                    else {
                        lv_x = RandomInt(0, 20);
                        if ((lv_x == 0)) {
                            GameSetToDLighting("Eclipse");
                            gv_lighting = "Eclipse";
                        }
                        else {
                            GameSetToDLighting("Agria");
                            gv_lighting = "Agria";
                        }
                    }
                }
            }
        }

    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_NPNightEnd_Init () {
    gt_NPNightEnd = TriggerCreate("gt_NPNightEnd_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: E - Pick Execution
//--------------------------------------------------------------------------------------------------
bool gt_EPickExecution_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_a;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((StringSub(EventChatMessage(false), 1, 1) != "-"))) {
            return false;
        }

        if (!((gv_executionPicking == EventPlayer()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_executionWish = EventChatMessage(false);
    gv_executionPicking = 0;
    gf_CBAllowDisallowChatting(EventPlayer(), ge_Allow_Disallow);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_EPickExecution_Init () {
    gt_EPickExecution = TriggerCreate("gt_EPickExecution_Func");
    TriggerEnable(gt_EPickExecution, false);
    TriggerAddEventChatMessage(gt_EPickExecution, c_playerAny, "", false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: AS - Action Button A Town
//--------------------------------------------------------------------------------------------------
bool gt_ASActionButtonATown_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_a;
    int lv_target;
    int lv_source;

    // Automatic Variable Declarations
    const int auto417BF33C_ae = 15;
    const int auto417BF33C_ai = 1;
    const int auto97EA5195_ae = 15;
    const int auto97EA5195_ai = 1;
    const int autoF4E71F3A_ae = 15;
    const int autoF4E71F3A_ai = 1;

    // Variable Initialization
    lv_source = EventPlayer();

    // Conditions
    if (testConds) {
        if (!((PlayerGroupHasPlayer(gv_alivePlayers, EventPlayer()) == true))) {
            return false;
        }

        if (!((gv_isNight == true))) {
            return false;
        }

        if (!((gv_roles[lv_source][1] == 1))) {
            return false;
        }

        if (!((DialogControlIsVisible(EventDialogControl(), EventPlayer()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_a = 1;
    for ( ; ( (auto417BF33C_ai >= 0 && lv_a <= auto417BF33C_ae) || (auto417BF33C_ai < 0 && lv_a >= auto417BF33C_ae) ) ; lv_a += auto417BF33C_ai ) {
        if ((gv_actionDialogItem[lv_a][5] == EventDialogControl())) {
            lv_target = lv_a;
        }

    }
    if ((lv_target > 0)) {
        if ((gv_roles[lv_source][1] == 1) && (gv_roles[lv_source][0] == 1) && (lv_target == lv_source) && (gv_variableOptions[lv_source][0] == 1)) {
            if ((gv_action[lv_source][0] != 0)) {
                gf_CBSystemMessage((StringExternal("Param/Value/02231CCF")), lv_source, lv_source, 0, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
                libNtve_gf_SetDialogItemTooltip(gv_actionDialogItem[lv_source][5], StringExternal("Param/Value/7D5E48DF"), PlayerGroupSingle(lv_source));
                libNtve_gf_SetDialogItemColor(gv_actionDialogItem[lv_source][5], Color(0.00, 0.00, 100.00), PlayerGroupSingle(lv_source));
                gv_action[lv_source][0] = 0;
            }
            else {
                gf_CBSystemMessage((StringExternal("Param/Value/652FBC9E")), lv_source, lv_source, 0, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
                libNtve_gf_SetDialogItemTooltip(gv_actionDialogItem[lv_source][5], StringExternal("Param/Value/5686041E"), PlayerGroupSingle(lv_source));
                libNtve_gf_SetDialogItemColor(gv_actionDialogItem[lv_source][5], Color(50.20, 50.20, 50.20), PlayerGroupSingle(lv_source));
                gv_action[lv_source][0] = lv_source;
            }
        }

        if ((gv_roles[lv_source][1] == 1) && (gv_roles[lv_source][0] == 2) && (gv_action[lv_source][0] != lv_target)) {
            if ((lv_target == lv_source) && (gv_action[lv_source][0] != 0)) {
                DialogControlSetVisible(gv_actionDialogItem[lv_source][5], PlayerGroupSingle(lv_source), false);
                DialogControlSetVisible(gv_actionDialogItem[gv_action[lv_source][0]][5], PlayerGroupSingle(lv_source), true);
                gf_CBSystemMessage((StringExternal("Param/Value/FABA5B3B")), lv_source, lv_source, 0, SoundLink("Silent", -1), Color(0.00, 0.00, 0.00));
                gv_action[lv_source][0] = 0;
