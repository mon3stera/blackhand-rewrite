void gf_PointAward (int lp_player, int lp_points, int lp_games, int lp_victories, string lp_idstr, int lp_special) {
    // Automatic Variable Declarations
    // Implementation
    if ((lp_idstr == PlayerHandle(lp_player))) {
        if ((gv_bankSpecialIntegers[lp_player][0] > lp_special)) {
            gv_bankGeneralIntegers[lp_player][3] += lp_points;
            gv_points[lp_player] += lp_points;
            gv_bankGeneralIntegers[lp_player][4] += lp_games;
            gv_gamesPlayed[lp_player] += lp_games;
            gv_bankRoleAchievements[lp_player][1][1] += lp_victories;
            gv_bankSpecialIntegers[lp_player][0] = lp_special;
            gf_CBSystemMessage(StringExternal("Param/Value/61045B9F"), lp_player, 0, 0, SoundLink("UI_BNet_Achievement", -1), Color(0,0,0));
        }

    }

}

void gf_PointSet (int lp_player, int lp_points, int lp_games, int lp_victories, string lp_idstr, int lp_special) {
    // Automatic Variable Declarations
    // Implementation
    if ((lp_idstr == PlayerHandle(lp_player))) {
        if ((gv_bankSpecialIntegers[lp_player][0] > lp_special)) {
            if ((lp_points >= 0)) {
                gv_bankGeneralIntegers[lp_player][3] *= 0;
                gv_bankGeneralIntegers[lp_player][3] += lp_points;
                gv_points[lp_player] *= 0;
                gv_points[lp_player] += lp_points;
            }

            if ((lp_games >= 0)) {
                gv_bankGeneralIntegers[lp_player][4] *= 0;
                gv_bankGeneralIntegers[lp_player][4] += lp_games;
                gv_gamesPlayed[lp_player] *= 0;
                gv_gamesPlayed[lp_player] += lp_games;
            }

            if ((lp_victories >= 0)) {
                gv_bankRoleAchievements[lp_player][1][1] *= 0;
                gv_bankRoleAchievements[lp_player][1][1] += lp_victories;
            }

            gv_bankSpecialIntegers[lp_player][0] = lp_special;
            gf_CBSystemMessage(StringExternal("Param/Value/B085A5F3"), lp_player, 0, 0, SoundLink("UI_BNet_Achievement", -1), Color(0,0,0));
        }

    }

}

