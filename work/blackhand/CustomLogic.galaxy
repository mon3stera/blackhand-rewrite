void gf_ESShadowKill (int lp_player, int lp_killer) {
    // Variable Declarations
    int lv_target;
    int lv_x;
    bool lv_c;
    playergroup auto9B99A3AA_g;
    int auto9B99A3AA_var;

    // Variable Initialization
    lv_target = lp_player;

    // Implementation
    if ((gv_nightSequence == true)) {
        Wait(RandomFixed(0.3, 0.6), c_timeGame);
        Wait(RandomFixed(0.6, 1.0), c_timeGame);
    }

    if ((gv_e5BC80E585B3[lp_killer] == false) && (gv_roleOptions[3][31][1] == false) && (gv_zuosi[lv_target] == false) && ((gv_immuneChance[lv_target] > 0) || (gv_immune[lv_target][0] == true))) {
        if ((gv_immuneChance[lv_target] > 0)) {
            gv_immuneChance[lv_target] = (gv_immuneChance[lv_target] - 1);
        }

        if ((gv_nightSequence == true)) {
            SoundPlay(SoundLink("Zeratul_AttackImpact", -1), PlayerGroupAll(), RandomFixed(80.0, 100.0), 0.0);
            gf_BHNotify(StringExternal("Param/Value/SHWNIGHT"), lv_target, SoundLink("Silent", -1));
            gf_FlashScreen(Color(100.00, 0.00, 100.00), lv_target, 3.0, 50.0);
            Wait(RandomFixed(0.4, 0.8), c_timeGame);
        }

        gf_BHNotify(StringExternal("Param/Value/SHWSURV"), lv_target, SoundLink("UI_TipSelect", -1));
        gf_CBSystemMessage(StringExternal("Param/Value/B9CD6B48"), lp_killer, lp_killer, 0, SoundLink("UI_TipSelect", -1), Color(0,0,0));
    }
    else {
        gv_specialCasePlayer[lv_target][12] += 1;
        gv_deathMethod[lv_target] = (gv_deathMethod[lv_target] + "w");
        if ((gv_nightSequence == true)) {
            SoundPlay(SoundLink("DarkTemplar_What", -1), PlayerGroupAll(), 100.0, 0.0);
            Wait(2.6, c_timeGame);
            SoundPlay(SoundLink("DarkTemplar_Attack", -1), PlayerGroupAll(), RandomFixed(80.0, 100.0), 0.0);
            auto9B99A3AA_g = PlayerGroupAll();
            auto9B99A3AA_var = -1;
            while (true) {
                auto9B99A3AA_var = PlayerGroupNextPlayer(auto9B99A3AA_g, auto9B99A3AA_var);
                if (auto9B99A3AA_var < 0) { break; }
                gf_CBSystemMessage(StringExternal("Param/Value/SHWHEAR"), auto9B99A3AA_var, 16, 0, SoundLink("Silent", -1), Color(0,0,0));
            }
            gf_BHNotify(StringExternal("Param/Value/SHWNIGHT"), lv_target, SoundLink("Silent", -1));
            gf_FlashScreen(Color(100.00, 0.00, 100.00), lv_target, 3.0, 50.0);
            Wait(RandomFixed(0.4, 0.8), c_timeGame);
        }

        if ((gv_e5BC80E585B3[lp_killer] == false) && (gv_roleOptions[3][31][1] == false) && (gv_healing[lv_target] > 0) && (gv_zuosi[lv_target] == false)) {
            gf_BHNotify(StringExternal("Param/Value/DB5AD8F8"), lv_target, SoundLink("UI_TipSelect", -1));
            gf_FlashScreen(Color(0.00, 100.00, 0.00), lv_target, 3.0, 0.0);
            gv_healing[lv_target] -= 1;
            gv_deathMethod[lv_target] = (gv_deathMethod[lv_target] + "h");
        }
        else {
            gv_placedNote[lv_target] = gv_deathNote[lp_killer];
            gv_diedAtNight[lv_target] = true;
            gv_e78AAFE7BDAAE4BA8BE5AE9E[lp_killer][1] = true;
            if (((gv_nightSequence == true) || (gv_deathDescriptions == true))) {
                lv_c = false;
                if ((gv_deathDesc[lv_target] == true)) {
                    lv_c = true;
                }

                gv_deathDesc[lv_target] = true;
                if ((lv_c == false)) {
                    lv_x = RandomInt(1, 3);
                    if ((lv_x == 1)) {
                        gv_deathText[lv_target] = (gv_deathText[lv_target] + StringExternal("Param/Value/SHWDEATH1"));
                    }

                    if ((lv_x == 2)) {
                        gv_deathText[lv_target] = (gv_deathText[lv_target] + StringExternal("Param/Value/SHWDEATH2"));
                    }

                    if ((lv_x == 3)) {
                        gv_deathText[lv_target] = (gv_deathText[lv_target] + StringExternal("Param/Value/SHWDEATH3"));
                    }

                }

            }

            gf_KillPlayer(lv_target, false);
            gv_e78AAFE7BDAAE4BA8BE5AE9E[lp_killer][1] = true;
        }
    }
}

void gf_RAShadowActions (int lp_player) {
    // Variable Declarations
    int lv_a;

    // Automatic Variable Declarations
    const int auto90FAB5B4_ae = 15;
    const int auto90FAB5B4_ai = 1;

    // Variable Initialization

    // Implementation
    lv_a = 1;
    for ( ; ( (auto90FAB5B4_ai >= 0 && lv_a <= auto90FAB5B4_ae) || (auto90FAB5B4_ai < 0 && lv_a >= auto90FAB5B4_ae) ) ; lv_a += auto90FAB5B4_ai ) {
        if ((PlayerGroupHasPlayer(gv_alivePlayers, lv_a) == true) && (lv_a != lp_player)) {
            libNtve_gf_SetDialogItemTooltip(gv_actionDialogItem[lv_a][6], StringExternal("Param/Value/SHWTGT2"), PlayerGroupSingle(lp_player));
            libNtve_gf_SetDialogItemColor(gv_actionDialogItem[lv_a][6], Color(100.00, 0.00, 100.00), PlayerGroupSingle(lp_player));
            DialogControlSetSize(gv_actionDialogItem[lv_a][6], PlayerGroupSingle(lp_player), 60, 30);
            libNtve_gf_SetDialogItemImage(gv_actionDialogItem[lv_a][6], "ActionSmallNormal.dds", PlayerGroupSingle(lp_player));
            libNtve_gf_SetDialogItemImage2(gv_actionDialogItem[lv_a][6], "ActionSmallHighlight.dds", PlayerGroupSingle(lp_player));
            DialogControlSetVisible(gv_actionDialogItem[lv_a][6], PlayerGroupSingle(lp_player), true);
            libNtve_gf_SetDialogItemTooltip(gv_actionDialogItem[lv_a][5], StringExternal("Param/Value/SHWTGT1"), PlayerGroupSingle(lp_player));
            libNtve_gf_SetDialogItemColor(gv_actionDialogItem[lv_a][5], Color(78.43, 50.20, 100.00), PlayerGroupSingle(lp_player));
            DialogControlSetSize(gv_actionDialogItem[lv_a][5], PlayerGroupSingle(lp_player), 60, 30);
            libNtve_gf_SetDialogItemImage(gv_actionDialogItem[lv_a][5], "ActionSmallNormal.dds", PlayerGroupSingle(lp_player));
            libNtve_gf_SetDialogItemImage2(gv_actionDialogItem[lv_a][5], "ActionSmallHighlight.dds", PlayerGroupSingle(lp_player));
            DialogControlSetVisible(gv_actionDialogItem[lv_a][5], PlayerGroupSingle(lp_player), true);
        }
        else {
            if ((lv_a == lp_player)) {
                libNtve_gf_SetDialogItemTooltip(gv_actionDialogItem[lv_a][6], StringExternal("Param/Value/1494BD17"), PlayerGroupSingle(lp_player));
                libNtve_gf_SetDialogItemColor(gv_actionDialogItem[lv_a][6], Color(50.20, 50.20, 50.20), PlayerGroupSingle(lp_player));
                DialogControlSetSize(gv_actionDialogItem[lv_a][6], PlayerGroupSingle(lp_player), 60, 30);
                libNtve_gf_SetDialogItemImage(gv_actionDialogItem[lv_a][6], "ActionSmallNormal.dds", PlayerGroupSingle(lp_player));
                libNtve_gf_SetDialogItemImage2(gv_actionDialogItem[lv_a][6], "ActionSmallHighlight.dds", PlayerGroupSingle(lp_player));
                libNtve_gf_SetDialogItemTooltip(gv_actionDialogItem[lv_a][5], StringExternal("Param/Value/353A8DFC"), PlayerGroupSingle(lp_player));
                libNtve_gf_SetDialogItemColor(gv_actionDialogItem[lv_a][5], Color(78.43, 50.20, 100.00), PlayerGroupSingle(lp_player));
                DialogControlSetSize(gv_actionDialogItem[lv_a][5], PlayerGroupSingle(lp_player), 60, 30);
                libNtve_gf_SetDialogItemImage(gv_actionDialogItem[lv_a][5], "ActionSmallNormal.dds", PlayerGroupSingle(lp_player));
                libNtve_gf_SetDialogItemImage2(gv_actionDialogItem[lv_a][5], "ActionSmallHighlight.dds", PlayerGroupSingle(lp_player));
                DialogControlSetVisible(gv_actionDialogItem[lv_a][5], PlayerGroupSingle(lp_player), true);
            }
            else {
                DialogControlSetVisible(gv_actionDialogItem[lv_a][5], PlayerGroupSingle(lp_player), false);
            }
            DialogControlSetVisible(gv_actionDialogItem[lv_a][6], PlayerGroupSingle(lp_player), false);
        }
    }
}


// 目标不是真实在线玩家（虚拟补位）时，私密消息改发主机，单人测试可见；真实玩家仍只发本人
void gf_BHNotify (text lp_msg, int lp_target, soundlink lp_sound) {
    if ((PlayerStatus(lp_target) == c_playerStatusActive)) {
        gf_CBSystemMessage(lp_msg, lp_target, lp_target, 0, lp_sound, Color(0,0,0));
    }
    else {
        gf_CBSystemMessage(lp_msg, gv_host, gv_host, 0, lp_sound, Color(0,0,0));
    }
}


// ===== 单人测试模式（-solo，仅测试构建生效）=====

bool gt_BHSolo_Init () {
    gt_BHSolo = TriggerCreate("gt_BHSolo_Func");
    TriggerAddEventChatMessage(gt_BHSolo, c_playerAny, "-solo", false);
    return true;
}

bool gt_BHSolo_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    gv_soloTest = true;
    TriggerEnable(gt_Prefer, true);
    // 不自动填角色：空位由大厅自行加电脑（c_bhSoloFill=false 时 Init2 不再虚拟补位）
    gf_CBSystemMessage(StringExternal("Param/Value/SOLOON"), EventPlayer(), 0, 0, SoundLink("UI_TipSelect", -1), Color(0, 0, 0));
    return true;
}

//--------------------------------------------------------------------------------------------------
// BH italic support: rewrite <i>x</i> to style tag; -italictest broadcasts candidates
//--------------------------------------------------------------------------------------------------
string gf_BHItalicize (string lp_s) {
    lp_s = StringReplaceWord(lp_s, "<i>", "<s val=\"ModItalic\">", c_stringReplaceAll, c_stringCase);
    lp_s = StringReplaceWord(lp_s, "</i>", "</s>", c_stringReplaceAll, c_stringCase);
    lp_s = StringReplaceWord(lp_s, "<I>", "<s val=\"ModItalic\">", c_stringReplaceAll, c_stringCase);
    lp_s = StringReplaceWord(lp_s, "</I>", "</s>", c_stringReplaceAll, c_stringCase);
    return lp_s;
}

bool gt_BHItalicTest_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    gf_CBSystemMessage(StringToText("A-<i>italic Italic 斜体测试</i>"), EventPlayer(), 0, 0, SoundLink("Silent", -1), Color(0,0,0));
    gf_CBSystemMessage(StringToText("B-<s val=\"ModItalic\">italic Italic 斜体测试</s>"), EventPlayer(), 0, 0, SoundLink("Silent", -1), Color(0,0,0));
    gf_CBSystemMessage(StringToText("C-<s val=\"ModItalic2\">italic Italic 斜体测试</s>"), EventPlayer(), 0, 0, SoundLink("Silent", -1), Color(0,0,0));
    return true;
}

bool gt_BHItalicTest_Init () {
    gt_BHItalicTest = TriggerCreate("gt_BHItalicTest_Func");
    TriggerAddEventChatMessage(gt_BHItalicTest, c_playerAny, "-italictest", false);
    return true;
}
