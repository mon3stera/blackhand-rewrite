                    }
                }

            }
            gv_skipVote[EventPlayer()] = false;
        }
        else {
            gv_skipVotes += gv_votes[EventPlayer()];
            auto618FC134_g = gv_currentPlayers;
            auto618FC134_var = -1;
            while (true) {
                auto618FC134_var = PlayerGroupNextPlayer(auto618FC134_g, auto618FC134_var);
