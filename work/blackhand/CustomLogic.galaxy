bool gt_OSSaveSlotCommand_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gf_OSSaveSlotBASE64(EventPlayer());
    gf_DEBUG(gv_bankSaveStrings[0][0][0]);
    gf_DEBUG(gv_bankSaveStrings[0][1][1]);
    gf_DEBUG(gv_bankSaveStrings[0][1][2]);
    gf_DEBUG(gv_bankSaveStrings[0][1][3]);
    libNtve_gf_SetDialogItemEditorValue(gv_save64BoxItem[0], gv_save64[EventPlayer()], PlayerGroupSingle(EventPlayer()));
    DialogSetVisible(gv_save64Box, PlayerGroupSingle(EventPlayer()), true);
