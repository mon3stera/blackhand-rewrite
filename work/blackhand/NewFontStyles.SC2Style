<StyleFile>
    <Style name="CustomInternational" template="InternationalTemplate" height="20" textcolor="#ColorWhite"/>    
    <!-- shw165/shw270：名字斜体两条路线，都不写 height → 都继承容器字号（shw158 实证）
         ① ModItalicAuto：含中文等非拉丁字符的名字 → 地图内置 Blackhand CJK Italic
            = Noto Sans CJK SC 切变 12° + upm 1000→870（约 1.15×）。
            旧写法 FontStandard+fontflags=Italic 会让中文缩成一小圈（引擎换到拉丁斜体、CJK 走错误字号回落）。
            FontGroup/CodepointRange 本版本完全不生效，所以中文必须单独内置，见 tools/make_cjk_italic.py
         ② ModItalicLatin：纯拉丁名字 → 地图内置 Blackhand Serif Italic
            = Lora Italic 放大 1.2×（OFL，Fonts\BH-Serif-Italic.ttf）
            放大做法：只把 unitsPerEm 改小（2048→1707）、轮廓一个点不动 → 同字号下字形整体大 1.2 倍，
            这样在 24px 卡面标题里能与汉字齐高；因带 Reserved Font Name，改动版已改名为 Blackhand Serif
         分流见 gf_BHNameLatinOnly / gf_BHItalicize -->
    <Constant name="SHWCJKItalicFont" val="Fonts\BH-CJK-Italic.ttf" />
    <Style name="ModItalicAuto" font="#SHWCJKItalicFont" />
    <Constant name="SHWItalicFont" val="Fonts\BH-Serif-Italic.ttf" />
    <Style name="ModItalicLatin" font="#SHWItalicFont" />
</StyleFile>
