<StyleFile>
    <Style name="CustomInternational" template="InternationalTemplate" height="20" textcolor="#ColorWhite"/>    
    <!-- shw88-153 遗留：固定 16px 的斜体（不再使用，留作应急回退） -->
    <Style name="ModItalic" font="#FontStandard" height="16" fontflags="Italic"/>
    <Style name="ModItalic2" font="#FontStandard" height="16" styleflags="Italic"/>
    <!-- shw163 路线一：含中文等非拉丁字符的名字 → 游戏自带字体 + 合成斜体 -->
    <Style name="ModItalicAuto" font="#FontStandard" fontflags="Italic"/>
    <!-- shw163 路线二：纯拉丁名字 → 地图内置 Lora Italic 真斜体（OFL，Fonts\Lora-Italic.ttf）
         不写 height 才会继承容器字号（shw158 实证）；FontGroup/CodepointRange 实测不生效，
         故中文回落改由脚本按字符白名单分流，见 gf_BHNameLatinOnly / gf_BHItalicize -->
    <Constant name="SHWItalicLora" val="Fonts\Lora-Italic.ttf" />
    <Style name="ModItalicLora" font="#SHWItalicLora" />
</StyleFile>
