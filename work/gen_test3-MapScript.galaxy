//==================================================================================================
// 
// Generated Map Script
// 
// Name:   Just Another StarCraft II Map
// 
//==================================================================================================
include "TriggerLibs/NativeLib"

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
}

//--------------------------------------------------------------------------------------------------
// Global Variables
//--------------------------------------------------------------------------------------------------
int gv_killCount;
int gv_genShown;
int gv_genDialog;
int gv_genBtn1;

void InitGlobals () {
    gv_genDialog = c_invalidDialogId;
    gv_genBtn1 = c_invalidDialogControlId;
}

//--------------------------------------------------------------------------------------------------
// Trigger Variables
//--------------------------------------------------------------------------------------------------
trigger gt_GenInit;
trigger gt_GenSpawn;
trigger gt_GenKill;

//--------------------------------------------------------------------------------------------------
// Trigger: GenInit
//--------------------------------------------------------------------------------------------------
bool gt_GenInit_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/B68823E1"));
    libNtve_gf_UnitCreateFacingPoint(1, "Marine", 0, 1, Point(64.0, 64.0), Point(64.0, 64.0));
    CameraPan(1, Point(64.0, 64.0), 0.0, 0.0, 0.0, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_GenInit_Init () {
    gt_GenInit = TriggerCreate("gt_GenInit_Func");
    TriggerAddEventMapInit(gt_GenInit);
}

//--------------------------------------------------------------------------------------------------
// Trigger: GenSpawn
//--------------------------------------------------------------------------------------------------
bool gt_GenSpawn_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/633284FE"));
    libNtve_gf_UnitCreateFacingPoint(1, "Zergling", 0, 2, Point(RandomFixed(20.0, 100.0), RandomFixed(20.0, 100.0)), Point(64.0, 64.0));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_GenSpawn_Init () {
    gt_GenSpawn = TriggerCreate("gt_GenSpawn_Func");
    TriggerAddEventTimePeriodic(gt_GenSpawn, 4.5, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: GenKill
//--------------------------------------------------------------------------------------------------
bool gt_GenKill_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gv_killCount += 1;
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, IntToText(gv_killCount));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_GenKill_Init () {
    gt_GenKill = TriggerCreate("gt_GenKill_Func");
    TriggerAddEventUnitDied(gt_GenKill, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_GenInit_Init();
    gt_GenSpawn_Init();
    gt_GenKill_Init();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    InitLibs();
    InitGlobals();
    InitTriggers();
}
